# Copy to bot/.env and fill in. bot/.env is gitignored - never commit the token.

# Discord application -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord application -> General Information -> Application ID
DISCORD_APPLICATION_ID=
# Right-click the server -> Copy Server ID (Developer Mode on). Commands are
# registered to this guild only, so they appear instantly.
DISCORD_GUILD_ID=

# #gamedata-updates. Make it an Announcement channel and the bot publishes each
# build message, so other servers can "Follow" it.
DISCORD_UPDATES_CHANNEL_ID=
# Private channel for failures: hint commands and log paths stay out of public.
# Empty = failures only get the short public line.
DISCORD_ADMIN_CHANNEL_ID=

# Where autopilot_notify.sh POSTs its events (AUTOPILOT_BOT_URL=http://127.0.0.1:13410/event).
# Loopback only: the bot never listens on a public interface.
BOT_HTTP_PORT=13410
# Shared secret; autopilot_notify.sh sends it as AUTOPILOT_BOT_SECRET.
# Generate one with: openssl rand -hex 32
BOT_EVENT_SECRET=

# Repository the bot reads (read-only: it never writes, commits or runs the pipeline).
REPO_ROOT=/root/CS2_VibeSignatures
SITE_URL=https://sig.miksen.me
