[Unit]
Description=CS2_VibeSignatures editor IDA session (Hex-Rays ida-mcp on 127.0.0.1:13337)
Documentation=file:/root/CS2_VibeSignatures/systemd/README.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/CS2_VibeSignatures
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.local/bin/uv run python ida_session.py
# run_linux.sh / run_windows.sh stop this unit while they analyse and start it on
# exit, so a stop is expected; anything else is restarted.
Restart=on-failure
RestartSec=30
# Stopping saves: the server releases its Nexus leases and each worker packs its .i64
# (up to 305 s each). The default control-group kill sent SIGTERM to the workers as
# well and SIGKILL after 90 s, which cut server.dll.i64 off mid-pack on 2026-10-12 -
# a database 9.4 then refused with "internal error 1228". Only the server is signalled;
# what is left after it exits is killed.
KillMode=mixed
TimeoutStopSec=600
# ...but the server exits on SIGTERM BEFORE its workers have packed, and mixed then kills
# them: 14191's libserver.so.i64 was left unopenable that way on 2026-10-15. ExecStop runs
# first and closes every database through the server (close_database waits for the pack),
# so the signal that follows finds nothing still writing.
ExecStop=/root/.local/bin/uv run python ida_session_stop.py --port 13337 --timeout 540
# One worker per open binary, each single-threaded; the cap keeps the editor from
# competing with an analysis run for memory.
MemoryHigh=12G
MemoryMax=16G
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
