[Unit]
Description=Check Steam for a new CS2 build every 15 minutes
Documentation=file:/root/CS2_VibeSignatures/systemd/README.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
# Catch up after a reboot or a suspend instead of waiting for the next window.
Persistent=true
# Spread the Steam query so it is not on the minute with everyone else.
RandomizedDelaySec=90
AccuracySec=1min
Unit=cs2vibe-autopilot.service

[Install]
WantedBy=timers.target
