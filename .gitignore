# Local fork scripts and files (git-ignored by design)
*.sh
# ...except the one that is not a local convenience but the fork's merge policy.
# sync_upstream.sh decides which paths survive an upstream merge (PROTECTED_PATHS)
# and how a submodule gitlink is restored; losing it to a fresh clone means the
# next sync silently hands those decisions back to upstream. It carries no
# secrets and no machine-specific paths, so it is version controlled.
!sync_upstream.sh
libtier0.so
libtier0.so.*
hm
clear_ida_db.sh
pop.sh
update_css_gamedata.sh
gamedatatest.json

# Basic Memory knowledge base (memory.db, config, logs stay local)
memory/*.db*
memory/config.json

# Genererede arbejdsfiler (missing-report, run-logs, alias-kandidater)
missing_*.txt
refs_gen_*.log
skill_hunt_*.log
hunt_*.log
alias_candidates_*.json

# sync_upstream.sh backups of untracked files replaced by upstream
.sync_backup/

# detect_aliases output (regenereres pr. kørsel)
alias_candidates_*.json
llmenv.sh

# autopilot runtime state (lock, attempt counters, last run logs)
.autopilot/

# hand-carried brief for the cs2-signatures VPS (not part of the repo)
NOTES-cs2-signatures.md

# consumer_drift_audit.py upstream download cache
/.cache/
baseline_facts/
auto_hunt_reports/
